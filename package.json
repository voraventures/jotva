{
  "name": "jotva",
  "productName": "Jotva",
  "version": "2.5.1",
  "description": "AI meeting notes. No bot. No cloud.",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:renderer": "vite",
    "build": "vite build",
    "build:speaker-host": "backend/.venv/bin/pyinstaller backend/speaker-host.spec --clean --distpath backend/dist --workpath backend/build --noconfirm",
    "build:zoom-helper": "mkdir -p native/bin && swiftc -O native/ZoomSpeakers.swift -o native/bin/jotva-zoom-speakers",
    "start": "npm run build && electron .",
    "clean:mac": "rm -rf release/mac release/mac-arm64 release/Jotva*.dmg release/Jotva*.dmg.blockmap release/latest-mac.yml",
    "build:backend": "backend/.venv/bin/pyinstaller backend/backend.spec --clean --distpath backend/dist --workpath backend/build --noconfirm",
    "dist:mac": "npm run build:backend && npm run clean:mac && npm run build && electron-builder --mac",
    "dist:win": "echo 'WARNING: a local Windows build is NOT shippable — it contains no backend, because PyInstaller cannot cross-compile a Windows binary from macOS. The real, backend-complete installer is built on Windows by .github/workflows/build-windows.yml. Use this target only for frontend/packaging tests.' && npm run build && electron-builder --win --config.extraMetadata.version=$(git describe --tags --abbrev=0 | sed 's/^v//')",
    "dist": "npm run clean:mac && npm run build && electron-builder --mac --win --config.extraMetadata.version=$(git describe --tags --abbrev=0 | sed 's/^v//')"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "shell-quote": "^1.8.4",
    "simple-icons": "^16.23.0",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "dompurify": "^3.2.3",
    "i18next": "^23.16.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3"
  },
  "build": {
    "appId": "app.jotva.desktop",
    "productName": "Jotva",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Jotva needs microphone access to record your meetings.",
        "NSAppleEventsUsageDescription": "Jotva uses Apple Events to detect active calls.",
        "NSCalendarsUsageDescription": "Jotva needs calendar access to detect upcoming meetings.",
        "NSScreenCaptureUsageDescription": "Jotva needs screen recording permission to capture system audio from your meetings."
      },
      "icon": "electron/assets/icon.icns",
      "artifactName": "Jotva.dmg",
      "notarize": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "signtoolOptions": {
        "publisherName": "Vora Ventures"
      },
      "icon": "electron/assets/icon.ico",
      "artifactName": "Jotva-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Jotva"
    },
    "protocols": [
      {
        "name": "Jotva",
        "schemes": [
          "jotva"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/dist/jotva-backend",
      "!**/credentials*.json",
      "!**/.env*"
    ],
    "extraResources": [
      {
        "from": "backend/dist/jotva-backend",
        "to": "backend/dist/jotva-backend"
      },
      { "from": "backend/dist/jotva-speaker-host", "to": "speaker-host" },
      { "from": "native/bin", "to": "native/bin" },
      { "from": "extensions/meet", "to": "extensions/meet" },
      { "from": "backend/app/speaker_notices", "to": "speaker-notices" }
    ],
    "linux": {
      "icon": "electron/assets/icon.png",
      "category": "Office",
      "target": "AppImage"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
